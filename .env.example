# HTTP server
HTTP_ADDR=:8081

# Redis connection and credentials
REDIS_ADDR=localhost:6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false
# 0 means cache entries never expire (a name is never sent to the LLM twice).
CACHE_TTL=0

# LLM proxy (OpenAI-compatible base URL; point this at /v1)
LLM_PROXY_URL=http://localhost:8080/v1
LLM_MODEL=gpt-4o-mini
# Bearer API key for the proxy (required by the gateway)
LLM_API_KEY=sk-gw-...
LLM_TIMEOUT=30s
